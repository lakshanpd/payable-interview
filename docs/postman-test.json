    },
    {
      "name": "Circles",
      "item": [
        {
          "name": "Create Circle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Friends Circle\",\n  \"contribution_amount\": 5000\n}"
            },
            "url": {
              "raw": "{{base_url}}/circles",
              "path": [
                "circles"
              ]
            }
          }
        },
        {
          "name": "Join Circle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invite_code\": \"{{invite_code}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/circles/join",
              "path": [
                "circles",
                "join"
              ]
            }
          }
        },
        {
          "name": "Get Circle Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/circles/{{circle_id}}",
              "path": [
                "circles",
                "{{circle_id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Rounds",
      "item": [
        {
          "name": "Get Round",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/rounds/{{round_id}}",
              "path": [
                "rounds",
                "{{round_id}}"
              ]
            }
          }
        },
        {
          "name": "Contribute",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/rounds/{{round_id}}/contribute",
              "path": [
                "rounds",
                "{{round_id}}",
                "contribute"
              ]
            }
          }
        },
        {
          "name": "Approve Round",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/rounds/{{round_id}}/approve",
              "path": [
                "rounds",
                "{{round_id}}",
                "approve"
              ]
            }
          }
        }
      ]
    }

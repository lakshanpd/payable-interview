{
  "info": {
    "name": "CircleFund API",
    "_postman_id": "circlefund-api",
    "description": "CircleFund Technical Assessment API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "circle_id",
      "value": "1"
    },
    {
      "key": "round_id",
      "value": "1"
    },
    {
      "key": "invite_code",
      "value": ""
    },
    {
      "key": "access_token",
      "value": ""
    }
  ],
